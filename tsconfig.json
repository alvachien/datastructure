{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "target": "ES2025",
    "module": "ES2022",
    "lib": [
      "ES2025",
      "dom"
    ],
    "types": [
      "jasmine",
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "karma.conf.ts",
    "dist"
  ]
}
